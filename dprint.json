{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "incremental": false,
  "includes": ["**/*.{ts,tsx,js,jsx,mjs,cjs}"],
  "indentWidth": 2,
  "lineWidth": 120,
  "newLineKind": "lf",
  "typescript": {
    "semiColons": "asi",
    "quoteStyle": "alwaysDouble",
    "trailingCommas": "never",
    "operatorPosition": "maintain",
    "arrowFunction.useParentheses": "force"
  },
  "excludes": [
    "**/node_modules",
    "**/dist",
    "repos",
    ".claude",
    "docs/.astro",
    "docs/public",
    "docs/src/content/docs/reference/api",
    "examples/devtools"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.93.4.wasm"
  ]
}
