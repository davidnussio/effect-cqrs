{
  "name": "effect-cqrs",
  "version": "0.4.0",
  "description": "CQRS and event sourcing for Effect v4, a port of moleculer-cqrs",
  "keywords": [
    "effect",
    "cqrs",
    "event-sourcing",
    "event-store",
    "aggregate",
    "projection",
    "sqlite",
    "postgres"
  ],
  "homepage": "https://davidnussio.github.io/effect-cqrs/",
  "bugs": {
    "url": "https://github.com/davidnussio/effect-cqrs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidnussio/effect-cqrs.git"
  },
  "type": "module",
  "license": "MIT",
  "author": "David Nussio",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "dist",
    "src",
    "LLMS.md",
    "!**/*.tsbuildinfo"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit && pnpm --recursive check",
    "lint": "oxlint && dprint check",
    "lint:fix": "oxlint --fix && dprint fmt",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "pnpm --filter effect-cqrs-examples run todo",
    "example:server": "pnpm --filter effect-cqrs-examples run server",
    "workshop": "pnpm --filter effect-cqrs-examples run workshop",
    "workshop:load": "pnpm --filter effect-cqrs-examples run workshop:load",
    "workshop:reset": "pnpm --filter effect-cqrs-examples run workshop:reset",
    "tutorial": "pnpm --filter effect-cqrs-examples run tutorial",
    "ui": "pnpm --filter effect-cqrs-examples run ui:bank",
    "ui:shop": "pnpm --filter effect-cqrs-examples run ui:shop",
    "ui:workshop": "pnpm --filter effect-cqrs-examples run ui:workshop",
    "build:workshop": "pnpm --filter effect-cqrs-examples run build:workshop",
    "build:workshop-server": "pnpm --filter effect-cqrs-examples run build:workshop-server",
    "docs": "pnpm --filter effect-cqrs-docs run dev",
    "docs:build": "pnpm --filter effect-cqrs-docs run build",
    "docs:preview": "pnpm --filter effect-cqrs-docs run preview",
    "bench": "node bench/performance.ts",
    "stress": "node --expose-gc bench/stress.ts",
    "qualify": "vitest run test/qualification --reporter=default --reporter=json --outputFile.json=qualification-report/results.json; node test/qualification/report.ts",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "peerDependencies": {
    "effect": "^4.0.6"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@effect/platform-node": "^4.0.6",
    "@effect/sql-pg": "^4.0.6",
    "@effect/sql-sqlite-node": "^4.0.6",
    "@effect/vitest": "^4.0.6",
    "@types/node": "^24.0.0",
    "dprint": "^0.64.3",
    "effect": "^4.0.6",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
