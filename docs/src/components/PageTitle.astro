---
/**
 * Starlight's page title, followed by a button that copies the page as Markdown and a
 * menu to view that Markdown or open the page in a chat. The Markdown comes from the
 * `[...slug].md` route.
 */
import { Icon } from "@astrojs/starlight/components"
import Default from "@astrojs/starlight/components/PageTitle.astro"

const { entry } = Astro.locals.starlightRoute
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const markdownPath = `${base}/${entry.id}.md`
// The 404 page isn't in the content collection, so it has no Markdown.
const hasMarkdown = entry.id !== "404"
const markdownUrl = new URL(markdownPath, Astro.site).href
const prompt = `Read ${markdownUrl}, a page of the effect-cqrs documentation, so I can ask questions about it.`
const chats = [
  { label: "Open in Claude", href: `https://claude.ai/new?q=${encodeURIComponent(prompt)}` },
  { label: "Open in ChatGPT", href: `https://chatgpt.com/?hints=search&q=${encodeURIComponent(prompt)}` }
]
---

<div>
  <Default />
  {hasMarkdown && (
    <cq-page-actions class="cq-actions not-content" data-markdown={markdownPath}>
      <button type="button" class="cq-copy">
        <Icon name="document" size="1rem" />
        <span data-label aria-live="polite">Copy page</span>
      </button>
      <details class="cq-menu">
        <summary aria-label="More ways to read this page">
          <Icon name="down-caret" size="1rem" />
        </summary>
        <ul>
          <li>
            <a href={markdownPath} target="_blank">
              <Icon name="seti:markdown" size="1rem" />
              <span>View as Markdown</span>
            </a>
          </li>
          {chats.map(({ href, label }) => (
            <li>
              <a href={href} target="_blank" rel="noopener noreferrer">
                <Icon name="external" size="1rem" />
                <span>{label}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
    </cq-page-actions>
  )}
</div>

<script>
  class PageActions extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>(".cq-copy")!
      const label = this.querySelector<HTMLElement>("[data-label]")!
      const menu = this.querySelector<HTMLDetailsElement>(".cq-menu")!
      const markdown = this.dataset.markdown!

      button.addEventListener("click", async () => {
        const text = fetch(markdown).then((response) => {
          if (!response.ok) throw new Error(`${response.status} ${markdown}`)
          return response.text()
        })
        try {
          // Safari only lets a click write to the clipboard if the write starts right
          // away, so the item takes the pending text.
          if (typeof ClipboardItem !== "undefined") {
            const blob = text.then((value) => new Blob([value], { type: "text/plain" }))
            await navigator.clipboard.write([new ClipboardItem({ "text/plain": blob })])
          } else {
            await navigator.clipboard.writeText(await text)
          }
          this.flash(label, "Copied")
        } catch {
          this.flash(label, "Copy failed")
        }
      })

      document.addEventListener("click", (event) => {
        if (menu.open && !menu.contains(event.target as Node)) menu.open = false
      })
      menu.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          menu.open = false
          menu.querySelector("summary")?.focus()
        }
      })
    }

    flash(label: HTMLElement, text: string) {
      label.textContent = text
      setTimeout(() => (label.textContent = "Copy page"), 2000)
    }
  }

  customElements.define("cq-page-actions", PageActions)
</script>

<style>
  .cq-actions {
    /* Above the content that follows, which the menu opens over. */
    position: relative;
    z-index: 1;
    display: inline-flex;
    margin-top: 0.75rem;
    border: 1px solid var(--cq-line-strong);
    border-radius: 999px;
    background: var(--cq-glass);
    backdrop-filter: blur(14px);
    font-size: var(--sl-text-sm);
  }

  .cq-copy,
  .cq-menu summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.8rem;
    border: 0;
    background: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 120ms ease, color 120ms ease;
  }

  .cq-copy {
    border-radius: 999px 0 0 999px;
  }

  .cq-menu summary {
    list-style: none;
    padding-inline: 0.55rem;
    border-inline-start: 1px solid var(--cq-line-strong);
    border-radius: 0 999px 999px 0;
  }

  .cq-menu summary::-webkit-details-marker {
    display: none;
  }

  .cq-copy:hover,
  .cq-menu summary:hover,
  .cq-menu[open] summary {
    color: var(--sl-color-white);
    background: rgba(255, 255, 255, 0.05);
  }

  .cq-copy:focus-visible,
  .cq-menu summary:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .cq-menu ul {
    position: absolute;
    inset-inline-start: 0;
    top: calc(100% + 0.4rem);
    min-width: 13rem;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    background: var(--cq-panel);
    border: 1px solid var(--cq-line-strong);
    border-radius: 0.75rem;
    box-shadow: 0 24px 60px -24px rgba(124, 92, 255, 0.55);
  }

  .cq-menu a {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.6rem;
    border-radius: 0.5rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    white-space: nowrap;
  }

  .cq-menu a:hover,
  .cq-menu a:focus-visible {
    color: var(--sl-color-white);
    background: rgba(124, 92, 255, 0.18);
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .cq-copy,
    .cq-menu summary {
      transition: none;
    }
  }
</style>
